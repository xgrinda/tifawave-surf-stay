# Development/Preview must NEVER use the production Supabase project.
# Allowed: development (local), test, staging, production (Vercel Production only).
TIFAWAVE_ENV=staging
TIFAWAVE_STAGING_PROJECT_REF=
TIFAWAVE_PRODUCTION_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional cutover/emergency pause; redeploy after changing. No database writes
# or emails are made by either public intake endpoint while this is true.
TIFAWAVE_PUBLIC_INTAKE_DISABLED=false

# Separate random secrets, at least 32 characters each. Never commit values.
BOOKING_REQUEST_SECRET=
NOTIFICATION_WORKER_SECRET=
# Optional: authenticated Owner can obtain scoped room/bed export URLs.
# Rotating this secret revokes all existing unit-calendar URLs.
ICAL_EXPORT_SECRET=

# Non-production mail is refused unless EVERY recipient is explicitly allowed.
STAGING_EMAIL_ALLOWLIST=
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_NOTIFICATION_EMAIL=

# Optional public analytics. Admin pages are excluded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional official review sync (owner-only, disabled unless configured).
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
